[Unit]
Description=ROS Mower Web Control Server
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=nfazio
Group=nfazio
WorkingDirectory=/mnt/nova_ssd/rosmowercompleate
Environment=ROSMOWER_WEB_PORT=80
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/usr/bin/python3 /mnt/nova_ssd/rosmowercompleate/web_server.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Allow running docker commands
SupplementaryGroups=docker

[Install]
WantedBy=multi-user.target
